# 文件作用：声明不应提交到 Git 的本地配置、构建产物和临时文件。

# 本地环境文件包含密钥，绝不能提交。
.env
.env.*
!.env.example

# Go 构建产物和覆盖率文件在本地生成。
bin/
dist/
.tmp-go-cache/
coverage.out
*.test

# 编辑器和操作系统噪声不应进入版本控制。
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地数据库转储可能包含真实机器人或客户数据。
*.dump
*.backup
*.sql.gz

# 本地实验期间创建的临时文件。
tmp/
logs/

# 本地助手或生成工具的记忆文件，不属于应用源码。
.workbuddy/
**/.workbuddy/
