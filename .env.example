# 文件作用：提供本地开发所需环境变量模板，不保存真实密钥。

# HTTP_ADDR 控制 Go 后端在本地监听的地址。
HTTP_ADDR=:8080

# DATABASE_URL 供后端连接 PostgreSQL/PostGIS 使用。
# 将真实密码保存在 .env 或服务器密钥中，不要提交到 Git。
DATABASE_URL=postgres://waterbot:waterbot_dev_password@localhost:5432/waterbot?sslmode=disable

# MQTT_BROKER_URL 指向 MQTT 消息代理。
# 在预发/生产环境启用 TLS 时，请使用 mqtts:// 和 8883 端口。
MQTT_BROKER_URL=tcp://localhost:1883

# MQTT_TELEMETRY_TOPIC 是接收机器人遥测的通配主题。
MQTT_TELEMETRY_TOPIC=v1/robots/+/telemetry

# APP_ENV 用于区分本地、预发和生产行为。
APP_ENV=local
