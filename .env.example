# 文件作用：提供后端本地开发所需环境变量模板。复制为 .env 后按需修改。

# 应用运行配置。
HTTP_ADDR=:8080
APP_ENV=local

# 最新位置快照异步写入 PostgreSQL 的间隔；实时内存与 SSE 不等待数据库。
LOCATION_SNAPSHOT_INTERVAL=1s

# PostgreSQL/PostGIS 本地连接串，与 docker-compose.yml 保持一致。
DATABASE_URL=postgres://waterbot:waterbot_dev_password@localhost:5432/waterbot?sslmode=disable

# MQTT Broker 本地连接配置，与 docker-compose.yml 保持一致。
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=watercleanbot-backend
MQTT_TELEMETRY_TOPIC=usv/+/telemetry
MQTT_COMMAND_CLIENT_ID=watercleanbot-command-publisher
MQTT_COMMAND_TOPIC=usv/%s/websend
# 船坞弹出指令 [EA 01 EB] 使用固定 Topic，并以 QoS 0 发布。
MQTT_DOCK_EJECT_TOPIC=a40i/sub
MQTT_ROUTE_TOPIC=usv/%s/websend
MQTT_FEEDBACK_TOPIC=usv/+/webfeedback
MQTT_USERNAME=
MQTT_PASSWORD=

# 摄像头播放配置。RTSP 原始地址只给 MediaMTX 使用，不要写进前端代码。
CAMERA_HLS_BASE_URL=/video
CAMERA_FRONT_RTSP=
CAMERA_REAR_RTSP=
# 与 nginx 注入的 Authorization: Bearer 保持一致；生成方式：openssl rand -hex 24
CAMERA_HLS_CDN_SECRET=change-me-to-a-long-random-hex-secret
# 账号与认证配置。
AUTH_REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
# 仅配置实际可信的反向代理 IP；未配置时不采信 X-Forwarded-For。
AUTH_TRUSTED_PROXIES=

# 可选的初始超级用户。四项均填写后，仅在系统不存在超级用户时创建。
INITIAL_SUPERUSER_USERNAME=
INITIAL_SUPERUSER_PASSWORD=
INITIAL_SUPERUSER_EMAIL=
INITIAL_SUPERUSER_DISPLAY_NAME=
