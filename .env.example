# HTTP_ADDR controls where the Go backend listens locally.
HTTP_ADDR=:8080

# DATABASE_URL is used by the backend to connect to PostgreSQL/PostGIS.
# Keep real passwords in .env or server secrets, not in Git.
DATABASE_URL=postgres://waterbot:waterbot_dev_password@localhost:5432/waterbot?sslmode=disable

# MQTT_BROKER_URL points to the MQTT message broker.
# Use mqtts:// and port 8883 when TLS is enabled in staging/production.
MQTT_BROKER_URL=tcp://localhost:1883

# MQTT_TELEMETRY_TOPIC is the wildcard topic that receives robot telemetry.
MQTT_TELEMETRY_TOPIC=v1/robots/+/telemetry

# APP_ENV separates local, staging, and production behavior.
APP_ENV=local
