# 文件作用：后端和本地部署环境变量。该文件需要随仓库部署到服务器。

# 应用运行配置。
HTTP_ADDR=:8080
APP_ENV=local

# 实时定位后台任务刷新间隔。
LOCATION_UPDATE_INTERVAL=5s

# PostgreSQL/PostGIS 本地连接串，与 docker-compose.yml 保持一致。
DATABASE_URL=postgres://waterbot:waterbot_dev_password@localhost:5432/waterbot?sslmode=disable

# MQTT Broker 本地连接配置，与 docker-compose.yml 保持一致。
MQTT_BROKER_URL=tcp://101.35.101.135:1883
MQTT_CLIENT_ID=watercleanbot-backend
MQTT_TELEMETRY_TOPIC=usv/+/telemetry
MQTT_COMMAND_CLIENT_ID=watercleanbot-command-publisher
MQTT_COMMAND_TOPIC=usv/%s/websend
MQTT_ROUTE_TOPIC=usv/%s/websend
MQTT_FEEDBACK_TOPIC=usv/+/webfeedback
MQTT_USERNAME=
MQTT_PASSWORD=

# 摄像头播放配置。RTSP 原始地址只给 MediaMTX 使用，不要写进前端代码。
CAMERA_HLS_BASE_URL=http://localhost:8888
CAMERA_FRONT_RTSP=rtsp://admin:jinghai32@192.168.4.10:554/Streaming/Channels/101
CAMERA_REAR_RTSP=rtsp://admin:Aisland12@192.168.4.64:554/Streaming/Channels/101
